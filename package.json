{
  "name": "claude-code-router",
  "private": true,
  "version": "2.0.0",
  "description": "Use Claude Code without an Anthropics account and route it to another LLM provider",
  "scripts": {
    "build": "pnpm build:shared && pnpm build:core && pnpm build:server && pnpm build:cli && pnpm build:ui",
    "build:core": "pnpm --filter @caeliq/llms build",
    "build:shared": "pnpm --filter @caeliq/ccr-shared build",
    "build:cli": "pnpm --filter @caeliq/claude-code-router build",
    "build:server": "pnpm --filter @caeliq/ccr-server build",
    "build:ui": "pnpm --filter @caeliq/ccr-ui build",
    "build:docs": "pnpm --filter claude-code-router-docs build",
    "release": "pnpm build && bash scripts/release.sh all",
    "release:npm": "bash scripts/release.sh npm",
    "release:docker": "bash scripts/release.sh docker",
    "dev:cli": "pnpm --filter @caeliq/claude-code-router dev",
    "dev:server": "pnpm --filter @caeliq/ccr-server dev",
    "dev:ui": "pnpm --filter @caeliq/ccr-ui dev",
    "dev:core": "pnpm --filter @caeliq/llms dev",
    "dev:docs": "pnpm --filter claude-code-router-docs start",
    "serve:docs": "pnpm --filter claude-code-router-docs serve"
  },
  "keywords": [
    "claude",
    "code",
    "router",
    "llm",
    "anthropic"
  ],
  "author": "caeliq",
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.23"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "esbuild": "^0.25.1",
    "shx": "^0.4.0",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}