{
  "name": "claude-code-router",
  "private": true,
  "version": "2.1.16",
  "description": "Use Claude Code without an Anthropics account and route it to another LLM provider",
  "scripts": {
    "build": "bun run build:shared && bun run build:core && bun run build:server && bun run build:cli && bun run build:ui",
    "build:core": "bun run --filter @caeliq/llms build",
    "build:shared": "bun run --filter @caeliq/ccr-shared build",
    "build:cli": "bun run --filter @caeliq/claude-code-router build",
    "build:server": "bun run --filter @caeliq/ccr-server build",
    "build:ui": "bun run --filter @caeliq/ccr-ui build",
    "build:docs": "bun run --filter claude-code-router-docs build",
    "test": "bun scripts/run-tests.js",
    "test:chrome-bridge": "bun scripts/run-tests.js --chrome-bridge",
    "test:live": "bun scripts/run-tests.js --live cli",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun run --filter '*' lint",
    "release": "bun run build && bash scripts/release.sh all",
    "release:npm": "bash scripts/release.sh npm",
    "release:docker": "bash scripts/release.sh docker",
    "dev:cli": "bun run --filter @caeliq/claude-code-router dev",
    "dev:server": "bun run --filter @caeliq/ccr-server dev",
    "dev:ui": "bun run --filter @caeliq/ccr-ui dev",
    "dev:core": "bun run --filter @caeliq/llms dev",
    "dev:docs": "bun run --filter claude-code-router-docs start",
    "serve:docs": "bun run --filter claude-code-router-docs serve"
  },
  "keywords": [
    "claude",
    "code",
    "router",
    "llm",
    "anthropic"
  ],
  "author": "caeliq",
  "license": "MIT",
  "dependencies": {
    "@cursor/sdk": "^1.0.37"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
