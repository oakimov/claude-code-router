{
  "name": "@caeliq/llms",
  "version": "1.0.74",
  "description": "A universal LLM API transformation server",
  "main": "dist/cjs/server.cjs",
  "module": "dist/esm/server.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/server.mjs",
      "require": "./dist/cjs/server.cjs"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:watch": "bun --watch scripts/build.ts",
    "dev": "bun run build:watch",
    "start": "bun dist/esm/server.mjs",
    "start:esm": "bun dist/esm/server.mjs",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "llm",
    "anthropic",
    "openai",
    "gemini",
    "transformer",
    "api"
  ],
  "author": "caeliq",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@caeliq/ccr-shared": "workspace:*",
    "@cursor/sdk": "^1.0.37",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@google/genai": "^2.30.0",
    "@huggingface/tokenizers": "^0.1.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "google-auth-library": "^11.3.1",
    "json5": "^2.2.3",
    "jsonrepair": "^3.15.0",
    "latex-to-unicode": "^0.1.0",
    "lru-cache": "^11.5.3",
    "openai": "^7.34.0",
    "tiktoken": "^1.0.22",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
